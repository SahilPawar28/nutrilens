{
  "hosting": [
    {
      "target": "primary",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "/downloads/nutrilens-android.bin",
          "headers": [
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"NutriLens.apk\""
            },
            {
              "key": "Content-Type",
              "value": "application/vnd.android.package-archive"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "/_expo/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "legacy",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "/downloads/nutrilens-android.bin",
          "headers": [
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"NutriLens.apk\""
            },
            {
              "key": "Content-Type",
              "value": "application/vnd.android.package-archive"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "/_expo/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}